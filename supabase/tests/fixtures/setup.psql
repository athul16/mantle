-- Shared fixture for the pgTAP files. Include it right after `begin;` with
--   \ir fixtures/setup.psql
-- It is not a test file itself (`supabase test db` only runs *.sql), so it has
-- no plan. Everything here lives inside the including file's transaction and
-- is rolled back with it.
--
-- Helpers (all in pg_temp, so they vanish with the session):
--   pg_temp.fx(name)           stable uuid for a fixture name (md5 based)
--   pg_temp.act_as(who)        switch role for the rest of the transaction:
--                              a user name below, 'anon', 'service' or 'owner'
--   pg_temp.count_as(who, q)   rows query q returns when run as `who`
--   pg_temp.try_as(who, q)     run statement q as `who` and undo it; returns
--                              the affected row count ('0', '1', ...) or the
--                              SQLSTATE it failed with ('42501' = denied)
--
-- Actors: org A has a_admin, a_recruiter, a_viewer; org B has b_admin and
-- b_viewer; outsider is signed in with no membership.

create extension if not exists pgtap with schema extensions;

create function pg_temp.fx(name text) returns uuid
language sql immutable as $$ select md5('pgtap:' || name)::uuid $$;

create function pg_temp.act_as(who text) returns void
language plpgsql as $$
begin
  if who = 'anon' then
    perform set_config('role', 'anon', true);
    perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  elsif who = 'service' then
    perform set_config('role', 'service_role', true);
    perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
  elsif who = 'owner' then
    perform set_config('role', 'postgres', true);
    perform set_config('request.jwt.claims', '', true);
  else
    perform set_config('role', 'authenticated', true);
    perform set_config(
      'request.jwt.claims',
      json_build_object('sub', pg_temp.fx(who), 'role', 'authenticated')::text,
      true
    );
  end if;
end;
$$;

-- The role switch happens inside a subtransaction that is always rolled back,
-- so the caller's role and data are untouched afterwards.
create function pg_temp.count_as(who text, q text) returns int
language plpgsql as $$
declare
  n int;
begin
  begin
    perform pg_temp.act_as(who);
    execute 'select count(*) from (' || q || ') s' into n;
    raise sqlstate 'TSTRB';
  exception when sqlstate 'TSTRB' then
    return n;
  end;
end;
$$;

create function pg_temp.try_as(who text, q text) returns text
language plpgsql as $$
declare
  n int;
begin
  begin
    perform pg_temp.act_as(who);
    execute q;
    get diagnostics n = row_count;
    raise sqlstate 'TSTRB';
  exception
    when sqlstate 'TSTRB' then return n::text;
    when others then return sqlstate;
  end;
end;
$$;

-- ---------------------------------------------------------------------------
-- Data, inserted as the owner (RLS bypassed)
-- ---------------------------------------------------------------------------

insert into auth.users (id, email)
select pg_temp.fx(n), 'pgtap-' || replace(n, '_', '-') || '@example.test'
from unnest(array['a_admin', 'a_recruiter', 'a_viewer', 'b_admin', 'b_viewer', 'outsider']) n;

insert into public.organizations (id, name, slug, settings) values
  (pg_temp.fx('org_a'), 'pgTAP Org A', 'pgtap-org-a', '{}'),
  (pg_temp.fx('org_b'), 'pgTAP Org B', 'pgtap-org-b', '{}');

insert into public.memberships (org_id, user_id, role) values
  (pg_temp.fx('org_a'), pg_temp.fx('a_admin'),     'admin'),
  (pg_temp.fx('org_a'), pg_temp.fx('a_recruiter'), 'recruiter'),
  (pg_temp.fx('org_a'), pg_temp.fx('a_viewer'),    'viewer'),
  (pg_temp.fx('org_b'), pg_temp.fx('b_admin'),     'admin'),
  (pg_temp.fx('org_b'), pg_temp.fx('b_viewer'),    'viewer');

