  (pg_temp.fx('lib_pub'),   null,                 'pgtap-lib',       'Library published', 'accounting', 1, '{"steps":[]}', now()),
  (pg_temp.fx('lib_draft'), null,                 'pgtap-lib-draft', 'Library draft',     'accounting', 1, '{"steps":[]}', null),
  (pg_temp.fx('scn_a'),     pg_temp.fx('org_a'),  'pgtap-own',       'A draft',           'accounting', 1, '{"steps":[]}', null),
  (pg_temp.fx('scn_a_pub'), pg_temp.fx('org_a'),  'pgtap-own',       'A published',       'accounting', 2, '{"steps":[]}', now()),
  (pg_temp.fx('scn_b'),     pg_temp.fx('org_b'),  'pgtap-own',       'B draft',           'accounting', 1, '{"steps":[]}', null);

