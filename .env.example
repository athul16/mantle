# Copy to .env.local and fill in. Values are in the Supabase dashboard:
# Project "assessment-platform" -> Project Settings -> API Keys.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://fexzsiizgcjuddtoeaui.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SECRET_KEY=sb_secret_...

# Server only. App emails (candidate invites, codes) go through Resend.
# Leave RESEND_API_KEY empty locally to write emails to .dev-outbox/ instead;
# set it (re_..., from Resend -> API Keys) to send for real.
RESEND_API_KEY=
EMAIL_FROM=Assessment Platform <no-reply@example.com>

# Server only. Shadow AI scoring of written replies (decision D8): after a
# submit, Claude Sonnet 5.5 scores each reply into a server-only table for
# comparison with human scores; nothing is shown or counted. Leave empty to
# skip it (it logs and does nothing). From the Claude Console -> API Keys.
ANTHROPIC_API_KEY=

# Base URL used in invite emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
