{
  "name": "assessment-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls.test.ts",
    "test:engine": "vitest run tests/engine",
    "test:jobs": "vitest run tests/jobs --passWithNoTests",
    "test:candidate": "vitest run tests/candidate --passWithNoTests",
    "test:integration": "vitest run tests/rls.test.ts tests/jobs tests/candidate",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:lhci": "lhci autorun",
    "db:test:start": "supabase start -x studio,imgproxy,logflare,vector,edge-runtime,supavisor,realtime && pnpm db:test:env",
    "db:test:stop": "supabase stop --no-backup",
    "db:test:reset": "supabase db reset && pnpm db:test:env",
    "db:test:env": "tsx scripts/test-env.mts",
    "scenarios:publish": "tsx --conditions=react-server scripts/publish-scenarios.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
